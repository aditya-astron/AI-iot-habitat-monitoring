# Copy to .env. Do not commit real keys.

# mock (default) uses habitat_monitor.genai.MockLLM — no network.
# openai requires OPENAI_API_KEY and calls an OpenAI-compatible chat endpoint.
GENAI_MODE=mock

# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

HABITAT_SERIAL_PORT=
HABITAT_BAUD=115200
HABITAT_DEVICE_ID=hab-01
HABITAT_LOG_LEVEL=INFO
